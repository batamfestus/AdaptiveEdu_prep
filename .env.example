# Copy this file to ".env" and fill in your own values.
# Leave DATABASE_URL empty to use a local SQLite file (fine for development).
DATABASE_URL=
ANTHROPIC_API_KEY=

# --- AI tutor (all optional: these are the defaults) ---
# ANTHROPIC_MODEL=claude-haiku-5-5
# Each student's limits over a rolling 24 hours (saved explanations are free and unlimited):
# TUTOR_DAILY_EXPLANATIONS=15
# TUTOR_DAILY_MESSAGES=25
# Emergency brake: total tokens (input + output) across ALL students per 24 hours:
# TUTOR_GLOBAL_DAILY_TOKENS=400000

# --- Research agent: web search (OFF until you switch it on) ---
# Each search costs about 1 cent PLUS the tokens for the pages it reads. Web search must also be
# enabled for your organization in the Anthropic Console (Settings > Capabilities).
# TUTOR_WEB_SEARCH=1
# TUTOR_DAILY_WEB_SEARCHES=5
# TUTOR_GLOBAL_DAILY_WEB_SEARCHES=100
# TUTOR_WEB_MAX_USES=2
# Sites the tutor may use, comma-separated (bare domains, no https://, no wildcards). Default list: HyperPhysics,
# Physics Classroom, Khan Academy, BBC Bitesize, OpenStax, LibreTexts, Physics Hypertextbook, Britannica,
# Wikipedia, JAMB. Replace it to narrow or widen the list:
# TUTOR_WEB_DOMAINS=hyperphysics.phy-astr.gsu.edu,physicsclassroom.com,khanacademy.org
# How strict "the notes cover this" is (0 to 1). Lower = searches the web less often.
# NOTES_WEAK_SCORE=0.30
